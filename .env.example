# GridShift environment template.
# Copy to .env for local development. Railway injects production values itself.

# --- API -------------------------------------------------------------------
ENVIRONMENT=development
# Local development uses SQLite so no Docker or Postgres is required.
# Railway sets this automatically for the attached Postgres service.
DATABASE_URL=sqlite:///./gridshift.db

# Comma-separated list of browser origins allowed to call the API directly.
# The Next.js server proxies same-origin traffic, so this is only needed for dev.
CORS_ORIGINS=http://localhost:3000

# External data sources (no API key required for Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=900

# Optimization guardrails
SOLVER_TIME_LIMIT_SECONDS=5
MAX_WORKLOADS=200
MAX_HORIZON_HOURS=168
MAX_CONCURRENT_OPTIMIZATIONS=4

# --- Web -------------------------------------------------------------------
# Private URL of the API as seen from the Next.js server.
# Local: http://127.0.0.1:8000
# Railway: http://gridshift-api.railway.internal:8000
API_INTERNAL_URL=http://127.0.0.1:8000
API_PROXY_TIMEOUT_MS=30000
